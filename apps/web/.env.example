# Copy to .env.local for local development. Next.js loads env files from this directory,
# so a repository-root .env is not read by the application.

# AssemblyAI, server-side only. Never prefix this with NEXT_PUBLIC_ (FR-011).
# Used to mint single-use browser tokens: GET https://agents.assemblyai.com/v1/token
ASSEMBLYAI_API_KEY=

# Voice Agent session parameters (spec/05). expires_in is the token redemption window,
# not the session length; the two are easy to confuse.
VOICE_AGENT_TOKEN_TTL_SECONDS=120
VOICE_AGENT_MAX_SESSION_SECONDS=600
VOICE_AGENT_VOICE=alba

# Neon Postgres. The Vercel Marketplace integration injects these on deployments;
# for local development copy the connection strings from the Neon console.
# DATABASE_URL is the pooled (PgBouncer) string used by the serverless driver.
DATABASE_URL=
# Direct connection string, used for schema changes.
DATABASE_URL_UNPOOLED=
